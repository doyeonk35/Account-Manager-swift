    "onboarding.addAccount.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click + in the toolbar (⌘N) to add an account.\nEnter a title, TVING ID, password, account type (QC/QA)\nand plan. Pin up to 2 accounts to keep them on top."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "툴바의 + 버튼(⌘N)으로 계정을 추가하세요.\n제목, TVING ID, 비밀번호, 계정 유형(QC/QA), 요금제를 입력합니다.\n자주 쓰는 계정은 최대 2개까지 상단에 고정할 수 있습니다."
          }
        }
      }
    },
