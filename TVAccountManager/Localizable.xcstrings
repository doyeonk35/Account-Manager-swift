    },
    "onboarding.import.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to Settings > Data and click Open Import Folder.\nRename presets.example.json to presets.json,\nfill in your accounts, then click Import.\nDuplicates are skipped automatically."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 > 데이터에서 불러오기 폴더 열기를 클릭하세요.\npresets.example.json을 presets.json으로 이름을 바꾸고\n계정을 입력한 뒤 불러오기를 클릭하면 됩니다.\n중복 계정은 자동으로 건너뜁니다."
          }
        }
      }
    },
